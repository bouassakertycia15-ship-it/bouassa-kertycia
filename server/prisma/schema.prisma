generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  SUPER_ADMIN
  ADMIN
  EDITOR
  WRITER
  MANAGER
  AUDIO_MANAGER
  VIDEO_MANAGER
  MODERATOR
  EVENT_MANAGER
  COMM_MANAGER
  READER
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  BLOCKED
}

enum ArticleStatus {
  DRAFT
  IN_REVIEW
  VALIDATED
  SCHEDULED
  PUBLISHED
  ARCHIVED
  REJECTED
}

enum ArticleSource {
  BLOG
  APPLICATION
}

enum EventStatus {
  UPCOMING
  ONGOING
  COMPLETED
}

enum ModerationStatus {
  PENDING
  APPROVED
  REJECTED
  ARCHIVED
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  IN_REVIEW
  DONE
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum MediaType {
  IMAGE
  AUDIO
  VIDEO
  DOCUMENT
  OTHER
}

model User {
  id            String      @id @default(uuid())
  email         String      @unique
  password      String
  name          String
  role          Role        @default(READER)
  status        UserStatus  @default(ACTIVE)
  avatar        String?
  bio           String?
  lastActivity  DateTime?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  comments      Comment[]
  contributions Contribution[]
  testimonials  Testimonial[]
  forumPosts    ForumPost[]
  forumDiscussions ForumDiscussion[]
  tasks         Task[]
  auditLogs     AuditLog[]
}

model Category {
  id        String   @id @default(uuid())
  name      String   @unique
  slug      String   @unique
  color     String?
  articles  Article[]
  podcasts  Podcast[]
  videos    Video[]
  forumCategories ForumCategory[]
  createdAt DateTime @default(now())
}

model Tag {
  id       String    @id @default(uuid())
  name     String    @unique
  slug     String    @unique
  articles Article[]
}

model Author {
  id        String   @id @default(uuid())
  name      String
  bio       String?
  avatar    String?
  articles  Article[]
  podcasts  Podcast[]
  videos    Video[]
  createdAt DateTime @default(now())
}

model Article {
  id              String        @id @default(uuid())
  title           String
  slug            String        @unique
  excerpt         String?
  content         String
  coverImage      String?
  images          String[]
  links           String[]
  status          ArticleStatus @default(PUBLISHED)
  source          ArticleSource @default(APPLICATION)
  originalUrl     String?
  blogPostId      String?
  dateImport      DateTime?
  dateModification DateTime?
  synchronized    Boolean       @default(false)
  featured        Boolean       @default(false)
  viewCount       Int           @default(0)
  publishedAt     DateTime     @default(now())
  scheduledAt     DateTime?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  authorId   String?
  author     Author?   @relation(fields: [authorId], references: [id])
  categoryId String?
  category   Category? @relation(fields: [categoryId], references: [id])
  tags       Tag[]
  comments   Comment[]
  versions   ArticleVersion[]
  tasks      Task[]
  auditLogs  AuditLog[]
}

model ArticleVersion {
  id        String   @id @default(uuid())
  articleId String
  article   Article @relation(fields: [articleId], references: [id], onDelete: Cascade)
  version   Int
  title     String
  content   String
  excerpt   String?
  coverImage String?
  editedBy  String
  editedAt  DateTime @default(now())
}

model Podcast {
  id          String    @id @default(uuid())
  title       String
  slug        String    @unique
  description String?
  coverImage  String?
  audioUrl    String
  duration    String?
  speaker     String?
  viewCount   Int       @default(0)
  status      ArticleStatus @default(PUBLISHED)
  authorId    String?
  author      Author?   @relation(fields: [authorId], references: [id])
  categoryId  String?
  category    Category? @relation(fields: [categoryId], references: [id])
  publishedAt DateTime  @default(now())
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model Video {
  id          String    @id @default(uuid())
  title       String
  slug        String    @unique
  description String?
  thumbnail   String?
  videoUrl    String
  speaker     String?
  viewCount   Int       @default(0)
  status      ArticleStatus @default(PUBLISHED)
  authorId    String?
  author      Author?   @relation(fields: [authorId], references: [id])
  categoryId  String?
  category    Category? @relation(fields: [categoryId], references: [id])
  publishedAt DateTime  @default(now())
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model Event {
  id          String      @id @default(uuid())
  title       String
  slug        String      @unique
  description String?
  poster      String?
  eventDate   DateTime
  eventTime   String?
  location    String?
  organizer   String?
  contact     String?
  status      EventStatus @default(UPCOMING)
  viewCount   Int         @default(0)
  gallery     String[]
  report      String?
  relatedArticleId String?
  relatedVideoId  String?
  relatedPodcastId String?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
}

model Activity {
  id           String   @id @default(uuid())
  title        String
  slug         String   @unique
  description  String?
  activityDate DateTime
  location     String?
  photos       String[]
  videos       String[]
  participants String?
  responsible  String?
  report       String?
  type         String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Member {
  id         String   @id @default(uuid())
  name       String
  role       String
  bio        String?
  photo      String?
  domain     String?
  socialLink String?
  contact    String?
  team       String?
  status     ModerationStatus @default(APPROVED)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model JocFamily {
  id       String   @id @default(uuid())
  name     String
  role     String
  bio      String?
  photo    String?
  parcours String?
  team     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Testimonial {
  id        String            @id @default(uuid())
  title     String
  content   String
  author    String
  userId    String?
  user      User?             @relation(fields: [userId], references: [id])
  status    ModerationStatus @default(PENDING)
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt
}

model Comment {
  id        String            @id @default(uuid())
  content   String
  articleId String
  article   Article           @relation(fields: [articleId], references: [id], onDelete: Cascade)
  userId    String?
  user      User?             @relation(fields: [userId], references: [id])
  userName  String
  status    ModerationStatus @default(PENDING)
  createdAt DateTime          @default(now())
}

model Notification {
  id        String   @id @default(uuid())
  title     String
  message   String
  type      String
  link      String?
  read      Boolean  @default(false)
  createdAt DateTime @default(now())
}

model SocialLink {
  id        String   @id @default(uuid())
  platform  String
  url       String
  icon      String?
  createdAt DateTime @default(now())
}

model Contribution {
  id          String            @id @default(uuid())
  type        String
  title       String
  content     String
  authorName  String
  authorEmail String?
  userId      String?
  user        User?             @relation(fields: [userId], references: [id])
  status      ModerationStatus @default(PENDING)
  adminReply  String?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
}

model Page {
  id        String   @id @default(uuid())
  title     String
  slug      String   @unique
  content   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model BlogSource {
  id        String    @id @default(uuid())
  name      String
  url       String
  feedUrl   String?
  lastSync  DateTime?
  createdAt DateTime  @default(now())
}

// Forum models
model ForumCategory {
  id          String   @id @default(uuid())
  name        String
  slug        String   @unique
  description String?
  icon        String?
  color       String?
  order       Int      @default(0)
  categoryId  String?
  category    Category? @relation(fields: [categoryId], references: [id])
  discussions ForumDiscussion[]
  createdAt   DateTime @default(now())
}

model ForumDiscussion {
  id          String   @id @default(uuid())
  title       String
  content     String
  slug        String   @unique
  views       Int      @default(0)
  pinned      Boolean  @default(false)
  locked      Boolean  @default(false)
  hidden      Boolean  @default(false)
  forumCategoryId String
  forumCategory   ForumCategory @relation(fields: [forumCategoryId], references: [id], onDelete: Cascade)
  userId      String?
  user        User?    @relation(fields: [userId], references: [id])
  authorName  String
  posts       ForumPost[]
  reports     Report[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model ForumPost {
  id          String   @id @default(uuid())
  content     String
  discussionId String
  discussion   ForumDiscussion @relation(fields: [discussionId], references: [id], onDelete: Cascade)
  userId      String?
  user        User?    @relation(fields: [userId], references: [id])
  authorName  String
  hidden      Boolean  @default(false)
  reports     Report[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Report {
  id            String   @id @default(uuid())
  reason        String
  reporterName  String
  status        ModerationStatus @default(PENDING)
  discussionId  String?
  discussion    ForumDiscussion? @relation(fields: [discussionId], references: [id], onDelete: Cascade)
  postId        String?
  post          ForumPost? @relation(fields: [postId], references: [id], onDelete: Cascade)
  createdAt     DateTime @default(now())
}

// Admin models
model AuditLog {
  id          String   @id @default(uuid())
  userId      String?
  user        User?    @relation(fields: [userId], references: [id])
  userName    String
  userRole    String
  action      String
  entity      String
  entityId    String?
  entityTitle String?
  details     String?
  statusBefore String?
  statusAfter  String?
  articleId   String?
  article     Article? @relation(fields: [articleId], references: [id], onDelete: SetNull)
  createdAt   DateTime @default(now())
}

model Task {
  id          String   @id @default(uuid())
  title       String
  description String?
  type        String
  status      TaskStatus @default(TODO)
  priority    TaskPriority @default(MEDIUM)
  dueDate     DateTime?
  assigneeId  String?
  assignee    User?    @relation(fields: [assigneeId], references: [id])
  articleId   String?
  article     Article? @relation(fields: [articleId], references: [id], onDelete: SetNull)
  internalComment String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Media {
  id        String   @id @default(uuid())
  name      String
  type      MediaType
  url       String
  size      Int?
  uploadedBy String?
  associatedContent String?
  createdAt DateTime @default(now())
}
